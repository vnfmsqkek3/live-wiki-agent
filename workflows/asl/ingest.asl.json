          "sk": {
            "S": "STEP#Finalize"
          },
          "doc_id": {
            "S.$": "$.ctx.doc_id"
          },
          "status": {
            "S": "FAILED"
          },
          "error": {
            "S.$": "$.error.Error"
          },
          "ended_at": {
            "S.$": "$$.State.EnteredTime"
          }
        }
      },
      "ResultPath": null,
      "Next": "Failed"
    },
    "Finalize": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_finalize}",
        "Payload": {
          "workflow_id.$": "$.ctx.workflow_id",
          "doc_id.$": "$.ctx.doc_id",
          "version.$": "$.ctx.version",
          "bucket.$": "$.ctx.bucket",
          "prefix.$": "$.ctx.prefix",
          "actor.$": "$.ctx.actor",
          "outcome.$": "$.outcome"
        }
      },
      "ResultSelector": {
        "status.$": "$.Payload.status"
      },
      "ResultPath": "$.last",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        },
        {
          "ErrorEquals": [
            "ThrottlingException",
            "TooManyRequestsException",
            "ServiceUnavailableException"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
