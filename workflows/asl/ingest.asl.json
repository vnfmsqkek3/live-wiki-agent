                  "actor.$": "$.ctx.actor"
                }
              },
              "ResultSelector": {
                "status.$": "$.Payload.status"
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2,
                  "JitterStrategy": "FULL"
                },
                {
                  "ErrorEquals": [
                    "ThrottlingException",
                    "TooManyRequestsException",
                    "ServiceUnavailableException"
                  ],
                  "IntervalSeconds": 10,
                  "MaxAttempts": 2,
                  "BackoffRate": 2,
                  "JitterStrategy": "FULL"
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "PageRender",
          "States": {
            "PageRender": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${fn_page_render}",
                "Payload": {
                  "workflow_id.$": "$.ctx.workflow_id",
