                  "prefix.$": "$.ctx.prefix",
                  "actor.$": "$.ctx.actor"
                }
              },
              "ResultSelector": {
                "status.$": "$.Payload.status"
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2,
                  "JitterStrategy": "FULL"
                },
                {
                  "ErrorEquals": [
                    "ThrottlingException",
                    "TooManyRequestsException",
                    "ServiceUnavailableException"
                  ],
                  "IntervalSeconds": 10,
                  "MaxAttempts": 2,
                  "BackoffRate": 2,
                  "JitterStrategy": "FULL"
                }
              ],
              "End": true
            }
          }
        }
      ],
      "ResultSelector": {
        "a.$": "$[0].status",
        "b.$": "$[1].status"
      },
      "ResultPath": "$.par",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "HandleError_ParallelPreprocess"
        }
      ],
      "Next": "Record_TextLayerExtract"
