      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "TextLayerExtract",
          "States": {
            "TextLayerExtract": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${fn_text_layer_extract}",
                "Payload": {
                  "workflow_id.$": "$.ctx.workflow_id",
