[
  {
    "name": "trace_impact",
    "description": "규정 개정 시 영향받는 노하우(직접 인용·1홉 간접)와 변경 근거. AUTHOR·REG_APPROVER 전용",
    "inputSchema": {
      "type": "object",
      "properties": {
        "law": {
          "type": "string",
          "description": "법령·규정 이름 또는 law_id (예: 한빛은행 기업여신 심사규정, SYN-LOAN-001)"
        },
        "old_revision": {
          "type": "string",
          "description": "이전 버전 (없으면 직전)"
        },
        "new_revision": {
          "type": "string",
          "description": "새 버전 (없으면 최신)"
        }
      },
      "required": [
        "law"
      ]
    }
  },
  {
    "name": "get_dependencies",
    "description": "그래프 노드(조문·노하우)의 나가는 관계 목록. AUTHOR·REG_APPROVER 전용",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "노드 ID (조문 ID 또는 {doc_id}@v{n})"
        }
      },
      "required": [
        "id"
      ]
    }
  }
]
