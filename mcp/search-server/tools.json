[
  {
    "name": "search_wiki",
    "description": "권한 안의 승인된 규정·노하우 검색. ACL은 서버가 사용자 신원으로 강제. 결과 0건은 UNVERIFIED(부재 단정 금지)",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "검색 질의"
        },
        "index_groups": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "legal-clauses",
              "wiki-knowledge",
              "official-manuals"
            ]
          }
        },
        "as_of": {
          "type": "string",
          "description": "기준일 YYYY-MM-DD. 없으면 오늘",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15,
          "description": "반환 개수 (기본 5)"
        },
        "include_history": {
          "type": "boolean",
          "description": "과거·삭제 조문 포함 (기본 false)"
        },
        "business": {
          "type": "string",
          "description": "업무 분류 필터 (예: 여신, 수신, 외환). Classify business_path 1단계"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "description": "태그 필터 (하나라도 일치)"
        },
        "dept": {
          "type": "string",
          "description": "부서 필터 (예: 여신, 공통)"
        },
        "date_from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "문서 일자(본문의 시행·개정·작성일) 시작 YYYY-MM-DD. 본문에 일자가 없는 문서는 기간 필터에서 빠짐"
        },
        "date_to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "문서 일자 끝 YYYY-MM-DD"
        },
        "authority_status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "UNVERIFIED"
          ],
          "description": "검증 상태 필터"
        },
        "freshness": {
          "type": "string",
          "enum": [
            "CURRENT",
            "REVIEW_REQUIRED"
          ],
          "description": "최신성 필터 (현행 / 재검토 필요). 현재 상태로 거르므로 상위 결과 밖 문서는 빠질 수 있음"
        },
        "rewrite": {
          "type": "boolean",
          "description": "기본 true: 문장형 질의를 핵심 질의(core)와 다른 표현(alternates)으로 재구성해 검색하고 응답 rewritten에 남긴다. false면 원래 질의 그대로"
        },
        "category": {
          "type": "string",
          "description": "업무 분류 경로(하위 포함). 예: \"경영지원\" 또는 \"경영지원/사무기기·시설\""
        }
      },
      "required": [
        "query"
      ]
    },
    "progress": "관련 규정과 노하우를 검색하는 중입니다"
  },
  {
    "name": "retrieve_evidence",
    "description": "지정한 문서 안에서 근거 구간 검색",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "검색 질의"
        },
        "doc_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "as_of": {
          "type": "string",
          "description": "기준일 YYYY-MM-DD. 없으면 오늘",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15,
          "description": "반환 개수 (기본 5)"
        },
        "include_history": {
          "type": "boolean",
          "description": "과거·삭제 조문 포함 (기본 false)"
        }
      },
      "required": [
        "query",
        "doc_ids"
      ]
    },
    "progress": "선택한 문서에서 근거를 찾는 중입니다"
  },
  {
    "name": "search_legal_clause",
    "description": "법령 질의. 조문 번호가 있으면 정확 조회를 먼저 하고, 없거나 확인 불가면 법령 색인 검색",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "질의 (예: 기업여신 심사규정 제12조제1항 승인 기준)"
        },
        "law": {
          "type": "string",
          "description": "법령·규정 이름 또는 law_id (예: 하나은행 기업여신 심사규정, SYN-LOAN-001)"
        },
        "as_of": {
          "type": "string",
          "description": "기준일 YYYY-MM-DD. 없으면 오늘",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15,
          "description": "반환 개수 (기본 5)"
        },
        "include_history": {
          "type": "boolean",
          "description": "과거·삭제 조문 포함 (기본 false)"
        }
      },
      "required": [
        "query"
      ]
    },
    "progress": "해당 조문을 찾는 중입니다"
  }
]
