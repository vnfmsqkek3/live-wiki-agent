{
  "name": "@hanaeum/api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "build:lambda": "esbuild src/handlers.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/handlers.mjs --external:@aws-sdk/* --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "build:server": "esbuild src/server.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/server.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "3.1169.0",
    "@aws-sdk/client-bedrock-runtime": "3.1169.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1169.0",
    "@aws-sdk/client-dynamodb": "3.1169.0",
    "@aws-sdk/client-lambda": "3.1169.0",
    "@aws-sdk/client-rds-data": "3.1169.0",
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/lib-dynamodb": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@hanaeum/db": "*",
    "@hanaeum/graph-server": "*",
    "@hanaeum/legal-parser": "*",
    "@hanaeum/pii": "*",
    "@hanaeum/regulation-server": "*",
    "@hanaeum/search-server": "*",
    "@hono/node-server": "2.1.8",
    "@types/pngjs": "6.0.5",
    "aws-jwt-verify": "5.2.1",
    "bedrock-agentcore": "0.4.7",
    "hono": "4.13.18",
    "pngjs": "7.0.0",
    "ulid": "3.0.2",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "fflate": "0.8.3"
  }
}
