{
  "name": "@hanaeum/api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "build:lambda": "esbuild src/handlers.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/handlers.mjs --external:@aws-sdk/* --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1169.0",
    "@aws-sdk/client-dynamodb": "3.1169.0",
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/client-sfn": "3.1169.0",
    "@aws-sdk/lib-dynamodb": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@hono/node-server": "2.1.8",
    "aws-jwt-verify": "5.2.1",
    "hono": "4.13.18",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
